# Copy this file to .env and change the values for your environment.
#
# NEVER put passwords, secret keys or tokens in this file or in .env.
# Every VITE_ variable is built into the JavaScript sent to the browser,
# so anyone using the app can read it.

# Where the backend API lives. In development the mock API answers here.
# For a real backend, use its address, for example:
# VITE_API_URL=https://api.example.com
VITE_API_URL=/api
