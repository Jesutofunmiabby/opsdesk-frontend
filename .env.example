# Copy this file to .env and change the values for your environment.
#
# NEVER put passwords, secret keys or tokens in this file or in .env.
# Every VITE_ variable is built into the JavaScript sent to the browser,
# so anyone using the app can read it.

# Where the backend API lives, including the version (see API_CONTRACT.md).
# In development the mock API answers here. For a real backend, use its
# address, for example:
# VITE_API_URL=https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Builds the mock API into the app, so a production build can be clicked
# through with no backend. For demos and preview ONLY: never set this to true
# for a real deployment, or people would see made-up tickets and their
# changes would only be saved in their own browser.
# npm run dev always uses the mock API. npm run preview:mock turns this on
# for its own build, without touching .env.
VITE_ENABLE_MOCKS=false
